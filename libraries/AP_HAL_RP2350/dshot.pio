;
; DShot bit encoding.
;
; dshot.pio.h is generated from this file and checked in beside it, because
; ArduPilot's own sources are built by waf rather than by the Pico-SDK's CMake
; and so cannot depend on a header generated during the CMake build. To
; regenerate it after editing this file:
;
;   modules/pico_sdk/tools/pioasm/pioasm dshot.pio dshot.pio.h
;
; (build pioasm first with cmake -S modules/pico_sdk/tools/pioasm -B <dir>
;  -DPIOASM_VERSION_STRING=2.3.0)
;

.program dshot
.side_set 1

; Every DShot bit begins high. A '0' returns low 37.5% of the way through the
; bit period and a '1' at 75%. Splitting each bit into T1 + T2 + T3 cycles
; leaves a '0' high for T1 and a '1' high for T1 + T2, so T1 = 3, T2 = 3,
; T3 = 2 places those edges at exactly 3/8 and 6/8 of the bit. The state
; machine therefore runs at 8x the wire bit rate.
.define public T1 3
.define public T2 3
.define public T3 2

.wrap_target
bitloop:
    ; Tail of the previous bit. With autopull set to 16 bits the state machine
    ; stalls on this instruction between frames, and a stalled instruction
    ; still drives its side-set, so the line rests low as DShot requires.
    out x, 1       side 0 [T3 - 1]
    jmp !x do_zero side 1 [T1 - 1] ; every bit starts high
do_one:
    jmp  bitloop   side 1 [T2 - 1] ; a '1' stays high through 75%
do_zero:
    nop            side 0 [T2 - 1] ; a '0' has already gone low
.wrap

; Bidirectional DShot.
;
; The frame is inverted - the line idles high and every bit starts low - after
; which the state machine stops driving the pin and samples the GCR encoded
; eRPM response the ESC sends back.
;
; The response runs at 5/4 of the frame bit rate, so one state machine clock
; has to divide both bit periods. 40 cycles per frame bit is the smallest that
; does: it leaves a whole 32 cycles per response bit, and it still divides into
; eighths for the 37.5%/75% frame bit encoding. The state machine therefore
; runs at 40x the wire bit rate rather than the 8x the unidirectional program
; needs.
;
; Nothing here bounds the wait for the response, because an ESC that is absent
; or silent would need a counter wider than a SET instruction can load. The
; driver puts a state machine still waiting at that point back to the top
; instead, on the tick after the frame it was answering.

.program bdshot
.side_set 1

.define public CYCLES_PER_BIT 40
.define public RESPONSE_BITS 21
.define FRAME_BITS 16
.define T1 15                       ; a '0' is low through 37.5% of the bit
.define T2 15
.define T3 10                       ; the high tail every bit ends with

.wrap_target
    set pindirs, 1          side 1  ; drive the line; it idles high
    pull block              side 1  ; one frame, left justified in the word
    set y, (FRAME_BITS - 1) side 1
bitloop:
    out x, 1                side 1 [T3 - 2]
    jmp !x do_zero          side 0 [T1 - 1] ; every bit starts low
do_one:
    jmp cont                side 0 [T2 - 1] ; a '1' stays low through 75%
do_zero:
    nop                     side 1 [T2 - 1] ; a '0' has already gone high
cont:
    jmp y-- bitloop         side 1

    nop                     side 1 [T3 - 2] ; the last bit's tail, before letting go
    set pindirs, 0          side 1
    wait 0 pin 0            side 1  ; the ESC answers by pulling the line low
    set y, (RESPONSE_BITS - 1) side 1 [15] ; half a response bit, to sample mid bit
sample:
    in pins, 1              side 1 [15]
    jmp y-- sample          side 1 [15]     ; 21 bits, then autopush
.wrap
