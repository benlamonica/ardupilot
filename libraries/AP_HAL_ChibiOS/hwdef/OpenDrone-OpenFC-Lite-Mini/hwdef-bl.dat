# bootloader hw definition file for the OpenDrone OpenFC-Lite-Mini (RP2354A)

MCU PICO2 PICO2

APJ_BOARD_ID AP_HW_OPENDRONE_OPENFC_LITE_MINI

# The directory name is over the 23 character limit for the board name.
define CHIBIOS_SHORT_BOARD_NAME "OpenFC-Lite-Mini"

OSCILLATOR_HZ 12000000
# X1 often needs longer than the default XOSC timeout (100 ms nominal, but
# timed on a ROSC assumed to be 6 MHz, so ~30-55 ms real) to start from cold,
# and a timeout halts before USB. Count 64x longer and wait up to ~1-2 s.
define RP_XOSC_STARTUP_DELAY_MULTIPLIER 64U
define RP_XOSC_STABLE_TIMEOUT_US 2000000U

FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 0
# Must be explicit, or chibios_hwdef.py reserves everything from the storage
# page to the end of flash and leaves no app area.
FLASH_RESERVE_END_KB 0

# Erase block 1 is parameter storage, so the app starts at block 2. Keep in
# step with FLASH_RESERVE_START_KB and STORAGE_FLASH_PAGE in hwdef.dat.
FLASH_BOOTLOADER_LOAD_KB 32
APP_START_OFFSET_KB 96
define APP_START_ADDRESS 0x10020000

define RP_FLASH_SIZE (BOARD_FLASH_SIZE * 1024U)

define HAL_USE_EFL                         TRUE
define HAL_USE_WDG                         TRUE
define HAL_USE_PAL                         TRUE
define HAL_USE_SIO                         TRUE
define HAL_USE_SERIAL                      FALSE
define HAL_USE_SERIAL_USB                  TRUE
define HAL_USE_UART                        FALSE
define RP_USB_USE_USB1                     TRUE

USB_STRING_MANUFACTURER "OpenDrone"

define BOOTLOADER_BAUDRATE 115200
define RP_CORE1_START FALSE
# QMI timing at the 150 MHz default clock: 50 MHz SCK.
define RP_QMI_CLKDIV 3
define RP_QMI_RXDELAY 2
define AP_FASTBOOT_ENABLED 1
define HAL_WITH_MCU_MONITORING 0
# Short power-on window; uploader.py reboots into the bootloader with a hold.
define HAL_BOOTLOADER_TIMEOUT 1000

SERIAL_ORDER OTG1

PB0 OTG_FS_DM OTG1
PB1 OTG_FS_DP OTG1

# Hold the IMU and microSD chip selects inactive.
PA13 IMU1_CS CS
PA21 SDCARD_CS CS

# Keep the 10V VTX rail and buzzer off while in the bootloader.
PA27 VTX_PWR OUTPUT LOW
PA17 BUZZER OUTPUT LOW
